<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Refreshify.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refreshify.Models">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="32,20,32,32" Spacing="4">
            <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
            <TextBlock
                x:Name="EmptyText"
                Text="Runs you start appear here, with their results."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <ItemsRepeater ItemsSource="{x:Bind Entries}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntry">
                        <Button
                            Style="{StaticResource CardButtonStyle}"
                            DataContext="{x:Bind}"
                            AutomationProperties.Name="{x:Bind Label}"
                            Click="OnEntryClick">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <InfoBadge Style="{x:Bind BadgeStyle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind When}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionStyle}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</UserControl>
