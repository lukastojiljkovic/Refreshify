<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Refreshify.Views.HealthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refreshify.Models">

    <UserControl.Resources>
        <!-- ItemsRepeater gives x:Bind templates their item without setting DataContext, which the click handler reads. -->
        <DataTemplate x:Key="HealthCardTemplate" x:DataType="models:HealthItem">
            <Grid Style="{StaticResource CardStyle}" MinHeight="68" DataContext="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="24" Height="24" VerticalAlignment="Top">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsRunning, Mode=OneWay}" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <FontIcon
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                        Style="{x:Bind IconStyle, Mode=OneWay}"
                        FontSize="20"
                        Visibility="{x:Bind IsDone, Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock
                        Text="{x:Bind Sentence, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Content="{x:Bind ActionLabel, Mode=OneWay}"
                    Visibility="{x:Bind HasAction, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Click="OnOpenClick" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- A column with a MaxWidth sits off-center directly in a ScrollViewer, so a Grid centers it. -->
    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="32,20,32,32" Spacing="4">
                <Grid Margin="0,0,0,16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Health" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="A quick look at your PC. Nothing is changed."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="CheckAgainButton"
                        Grid.Column="1"
                        Content="Check again"
                        VerticalAlignment="Bottom"
                        Click="OnCheckAgainClick" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource HealthCardTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
