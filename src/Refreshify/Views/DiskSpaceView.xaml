<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Refreshify.Views.DiskSpaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refreshify.Models">

    <UserControl.Resources>
        <!-- The whole row is a click target, so the item sits on the Grid's DataContext for the handlers. -->
        <DataTemplate x:Key="SpaceRowTemplate" x:DataType="models:SpaceRowItem">
            <Grid Style="{StaticResource CardStyle}" MinHeight="56" DataContext="{x:Bind}" Tapped="OnRowTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <Button
                        Margin="-8,0,0,0"
                        Padding="8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        Visibility="{x:Bind IsFolder}"
                        Click="OnOpenFolderClick">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{x:Bind Name}" Visibility="{x:Bind IsFile}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{x:Bind Bar}" Maximum="100" Height="4" HorizontalAlignment="Stretch" Visibility="{x:Bind ShowBar}" />
                    <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SecondaryCaptionStyle}" Visibility="{x:Bind ShowCaption}" />
                </StackPanel>

                <TextBlock Grid.Column="2" MinWidth="90" Text="{x:Bind Size}" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    MinWidth="56"
                    Text="{x:Bind Share}"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ShowShare}"
                    Style="{StaticResource SecondaryBodyStyle}" />
                <Button
                    Grid.Column="4"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Open in File Explorer"
                    AutomationProperties.Name="{x:Bind OpenLabel}"
                    Click="OnOpenInExplorerClick">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- A column with a MaxWidth sits off-center directly in a ScrollViewer, so a Grid centers it. -->
    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="32,20,32,32" Spacing="4">
                <TextBlock Text="Disk space" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="See which folders take up the most space. Nothing is deleted from here."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid Margin="0,16,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LocationBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Location" />
                    <Button
                        x:Name="ScanButton"
                        Grid.Column="1"
                        Content="Scan"
                        MinWidth="120"
                        Padding="20,8"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnScanClick" />
                </Grid>

                <Grid x:Name="ProgressRow" Margin="0,12,0,0" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="ScanRing" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProgressText" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Scan progress" />
                    <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="OnStopClick" />
                </Grid>

                <TextBlock x:Name="PartialText" Text="Partial results" Style="{StaticResource SecondaryBodyStyle}" Visibility="Collapsed" />

                <StackPanel x:Name="Results" Spacing="4" Visibility="Collapsed">
                    <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="OnBreadcrumbClicked" />
                    <SelectorBar x:Name="Views" Margin="0,8,0,0" SelectionChanged="OnViewChanged">
                        <SelectorBarItem Text="Folders" IsSelected="True" />
                        <SelectorBarItem Text="Largest files" />
                    </SelectorBar>

                    <ItemsRepeater x:Name="Rows" ItemTemplate="{StaticResource SpaceRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock x:Name="RemainderText" Style="{StaticResource SecondaryBodyStyle}" Visibility="Collapsed" />

                    <Expander
                        x:Name="UnreadableExpander"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Visibility="Collapsed">
                        <ItemsControl x:Name="UnreadableList" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource SecondaryBodyStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <TextBlock
                        x:Name="OnlineOnlyText"
                        Margin="0,8,0,0"
                        Text="Online-only files are not counted, because they take no space on this PC."
                        TextWrapping="Wrap"
                        Style="{StaticResource SecondaryBodyStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="UnseenText"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Style="{StaticResource SecondaryBodyStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
