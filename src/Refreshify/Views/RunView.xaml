<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Refreshify.Views.RunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refreshify.Models">

    <UserControl.Resources>
        <!-- An InfoBadge stretches to fill its slot, so it gets a fixed size. -->
        <DataTemplate x:Key="StepIconTemplate" x:DataType="models:StepItem">
            <Grid Width="20" Height="20">
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsRunning, Mode=OneWay}" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                <InfoBadge
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{x:Bind BadgeStyle, Mode=OneWay}"
                    Visibility="{x:Bind HasBadge, Mode=OneWay}" />
                <FontIcon
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind HasGlyph, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StepListTemplate" x:DataType="models:StepItem">
            <Grid Padding="0,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource StepIconTemplate}" IsTabStop="False" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="0,2,0,0" Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StepDetailsTemplate" x:DataType="models:StepItem">
            <!-- The buttons act on Model.Selected. Binding DataContext here overflows the stack inside a ContentControl. -->
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource StepIconTemplate}" IsTabStop="False" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind Time, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Margin="0,16,0,0" Text="{x:Bind Summary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Grid Margin="0,4,0,0" ColumnSpacing="12" Visibility="{x:Bind IsRunning, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                        Value="{x:Bind Percent, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Name}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                </Grid>

                <Border
                    Margin="0,12,0,0"
                    Padding="12,8"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="{x:Bind HasActivity, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Activity, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.Name="Latest output" />
                </Border>

                <StackPanel Margin="0,12,0,0" Spacing="2" Visibility="{x:Bind HasIssue, Mode=OneWay}">
                    <TextBlock Text="{x:Bind IssueTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind IssueExplanation, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Margin="0,8,0,0"
                    Text="{x:Bind Details, Mode=OneWay}"
                    Visibility="{x:Bind HasDetails, Mode=OneWay}"
                    Style="{StaticResource SecondaryCaptionStyle}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HasActions, Mode=OneWay}">
                    <Button
                        Content="{x:Bind FixLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ShowFix, Mode=OneWay}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        Click="OnFixClick" />
                    <Button Content="Restart now" Visibility="{x:Bind ShowRestart, Mode=OneWay}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" Click="OnRestartClick" />
                    <Button Content="Try again" Visibility="{x:Bind ShowRetry, Mode=OneWay}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" Click="OnRetryClick" />
                    <Button Content="Get help" Visibility="{x:Bind ShowHelp, Mode=OneWay}" Click="OnHelpClick" />
                </StackPanel>

                <Expander
                    Margin="0,16,0,0"
                    Header="Technical details"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ShowOutput, Mode=OneWay}">
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                        <TextBlock Text="{x:Bind Output, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PaneStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1400" Padding="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Model.Title}" Style="{StaticResource TitleTextBlockStyle}" Visibility="{x:Bind Model.IsLive}" />
            <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="OnBreadcrumbClicked" Visibility="Collapsed">
                <BreadcrumbBar.Resources>
                    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                    <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                    <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                </BreadcrumbBar.Resources>
            </BreadcrumbBar>
            <TextBlock Text="{x:Bind Model.StartedText}" Style="{StaticResource SecondaryCaptionStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Bind Model.ElapsedLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBlock Text="{x:Bind Model.Elapsed, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Steps finished" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBlock Text="{x:Bind Model.StepsFinished, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Freed" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBlock Text="{x:Bind Model.Freed, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Need attention" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBlock Text="{x:Bind Model.Attention, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="24" Visibility="{x:Bind Model.IsBusy, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" />
                <ProgressBar Value="{x:Bind Model.Progress, Mode=OneWay}" AutomationProperties.Name="Run progress" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" IsEnabled="{x:Bind Model.CanCancel, Mode=OneWay}" Click="OnCancelClick" />
        </Grid>

        <InfoBar
            Grid.Row="3"
            Margin="0,16,0,0"
            IsClosable="False"
            IsOpen="{x:Bind Model.ShowSummary, Mode=OneWay}"
            Severity="{x:Bind Model.SummarySeverity, Mode=OneWay}"
            Title="{x:Bind Model.SummaryTitle, Mode=OneWay}"
            Message="{x:Bind Model.SummaryMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Restart now" Visibility="{x:Bind Model.RestartRequired, Mode=OneWay}" Click="OnRestartClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="4" Margin="0,16,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" MaxWidth="380" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PaneStyle}">
                <ListView
                    x:Name="StepList"
                    Padding="0,4"
                    ItemsSource="{x:Bind Model.Steps}"
                    SelectedItem="{x:Bind Model.Selected, Mode=OneWay}"
                    ItemTemplate="{StaticResource StepListTemplate}"
                    ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                    SelectionChanged="OnStepSelectionChanged"
                    AutomationProperties.Name="Steps" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PaneStyle}">
                <ScrollViewer>
                    <ContentControl
                        Padding="24,20"
                        IsTabStop="False"
                        HorizontalContentAlignment="Stretch"
                        Content="{x:Bind Model.Selected, Mode=OneWay}"
                        ContentTemplate="{StaticResource StepDetailsTemplate}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
