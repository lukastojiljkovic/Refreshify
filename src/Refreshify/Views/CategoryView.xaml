<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Refreshify.Views.CategoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refreshify.Models">

    <UserControl.Resources>
        <!-- ItemsRepeater gives x:Bind templates their item without setting DataContext, which the click handlers read. -->
        <DataTemplate x:Key="ToolTemplate" x:DataType="models:ToolItem">
            <Grid Style="{StaticResource CardStyle}" MinHeight="68" DataContext="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind HasUseWhen}">
                        <Run Text="Use it when: " FontWeight="SemiBold" /><Run Text="{x:Bind UseWhen}" />
                    </TextBlock>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind Badges}" Visibility="{x:Bind HasBadges}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    Padding="8,1,8,2"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox
                        Content="Include in Run all"
                        IsChecked="{x:Bind IsInRunAll, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind IncludeLabel}"
                        Click="OnIncludeClick" />
                    <Button Content="Run" AutomationProperties.Name="{x:Bind RunLabel}" Click="OnRunClick" />
                    <Button
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="{x:Bind DetailsLabel}"
                        ToolTipService.ToolTip="Details">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel MaxWidth="380" Spacing="8">
                                    <TextBlock Text="What it runs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Technical}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind RunsAs}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- A column with a MaxWidth sits off-center directly in a ScrollViewer, so a Grid centers it. -->
    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="1000" Padding="32,20,32,32" Spacing="4">
                <Grid Margin="0,0,0,16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Category.Name}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Category.Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="RunSelectedButton"
                        Grid.Column="1"
                        Content="Run selected"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Runs the tools on this page that are included in Run all"
                        Click="OnRunSelectedClick" />
                </Grid>

                <ItemsRepeater x:Name="ToolRepeater" ItemsSource="{x:Bind Tools}" ItemTemplate="{StaticResource ToolTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
