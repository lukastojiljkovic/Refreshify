<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Refreshify.Dialogs.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Welcome to Refreshify"
    PrimaryButtonText="Get started"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="StepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="20">
        <TextBlock
            TextWrapping="Wrap"
            Text="Refreshify runs the maintenance tools built into Windows for you, and explains what they do and what they found in plain language." />

        <Grid ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon Glyph="&#xE768;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Run all, or pick what you need" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="Run all cleans up, repairs and updates your PC in one go. Each category lets you choose its tools or run them one at a time." />
            </StackPanel>

            <FontIcon Grid.Row="1" Glyph="&#xE9D9;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Watch it work" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="Each step shows its progress and result here. The tools run in the background, without command windows." />
            </StackPanel>

            <FontIcon Grid.Row="2" Glyph="&#xE90F;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Text="Get problems solved" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="When a step fails for a known reason, Refreshify fixes it or tells you how. Otherwise, it prepares a report you can paste into an AI assistant." />
            </StackPanel>
        </Grid>

        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="Some tools change Windows"
            Message="Repairs and updates change system files and settings, and some need a restart. Refreshify creates a restore point first, and never restarts your PC without asking." />

        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            Refreshify is free, open-source software provided as is, without warranty. By using it, you agree to the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/Refreshify/blob/main/TERMS.md">Terms of Use</Hyperlink>. It doesn't collect any data; see the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/Refreshify/blob/main/PRIVACY.md">privacy statement</Hyperlink>.
        </TextBlock>

        <CheckBox x:Name="DontShowAgainBox" Content="Don't show this again" />
    </StackPanel>
</ContentDialog>
